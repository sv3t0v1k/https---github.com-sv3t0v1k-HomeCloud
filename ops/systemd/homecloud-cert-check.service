[Unit]
Description=HomeCloud cert-check
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
WorkingDirectory=/
ExecStart=/usr/bin/python3 /opt/homecloud/scripts/scheduled-operations.py /etc/homecloud/scheduler.json cert-check
TimeoutStartSec=8400
KillMode=control-group
StandardOutput=journal
StandardError=journal
