# PUBLIC_HOST is a bare lowercase DNS hostname. Terminate public TLS at this boundary.
server {
  listen 80 default_server;
  server_name _;
  return 308 https://${PUBLIC_HOST}$request_uri;
}
server {
  listen 443 ssl default_server;
  server_name ${PUBLIC_HOST};
  ssl_certificate /etc/nginx/tls/fullchain.pem;
  ssl_certificate_key /etc/nginx/tls/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  if ($host != "${PUBLIC_HOST}") { return 421; }

  # The TLS boundary owns browser policy; do not duplicate backend Helmet headers.
  proxy_hide_header Strict-Transport-Security;
  proxy_hide_header X-Content-Type-Options;
  proxy_hide_header Referrer-Policy;
  proxy_hide_header X-Frame-Options;
  proxy_hide_header Content-Security-Policy;
  proxy_hide_header Permissions-Policy;

  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header X-Frame-Options "DENY" always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self'; media-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

  location ~* ^/(?:api/(?:v1/)?)?(?:health|metrics)(?:/|$) { return 404; }
  location / {
    client_max_body_size 51m;
    proxy_request_buffering off;
    proxy_http_version 1.1;
    proxy_pass http://frontend:80;
    proxy_set_header Host ${PUBLIC_HOST};
    proxy_set_header X-Forwarded-Host ${PUBLIC_HOST};
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }
}
