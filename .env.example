# Иллюстрация external runtime config, не рабочие секреты и не repo .env.
# Canonical запуск: README + docs/operations-runbook.md; заменить placeholders.
# Compose задаёт DATABASE_URL/FRONTEND_URL/STORAGE_PATH для backend.
# Database
DB_NAME=homecloud
DB_USER=homecloud
DB_PASSWORD=change-me-in-production

# JWT - generate strong secrets (min 32 chars) for production
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Redis выключен в canonical local baseline; пароль только при отдельном включении.
REDIS_PASSWORD=

# Storage
STORAGE_PATH=/storage
# Настраиваемый максимум одного файла в байтах; default policy 1 ТиБ.
# 0 — явный opt-in без отдельного потолка; storageQuota продолжает действовать.
MAX_FILE_SIZE=1099511627776
# Сумма резервов активных upload sessions пользователя; default policy 2 ТиБ.
# Уже сохранённые файлы учитывает storageQuota. 0 — явный opt-in без потолка.
MAX_TOTAL_SIZE=2199023255552
# Максимум чанков одной сессии; клиент адаптирует chunk до MAX_CHUNK_SIZE.
MAX_UPLOAD_CHUNKS=100000
# Maximum allowed chunk size (bytes)
MAX_CHUNK_SIZE=52428800

# Canonical local ingress; production требует реально квалифицированный hostname.
PUBLIC_HOST=homecloud.localhost
# Абсолютные внешние paths; заменить на существующие защищённые каталоги.
TLS_CERT_DIR=/absolute/external/homecloud/tls
ACME_WEBROOT_DIR=/absolute/external/homecloud/challenges
