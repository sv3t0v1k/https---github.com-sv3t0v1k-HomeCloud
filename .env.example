# Database
DB_NAME=homecloud
DB_USER=homecloud
DB_PASSWORD=change-me-in-production

# JWT - generate strong secrets (min 32 chars) for production
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=change-me-in-production

# Storage
STORAGE_PATH=/storage
# Maximum size of a single file (bytes). 0 = unlimited (not recommended).
MAX_FILE_SIZE=1073741824
# Maximum total size for a single upload session (bytes). Must be >= MAX_FILE_SIZE.
MAX_TOTAL_SIZE=10737418240
# Default chunk size used by the client (bytes)
CHUNK_SIZE=10485760
# Maximum allowed chunk size (bytes)
MAX_CHUNK_SIZE=52428800

# Frontend
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3000
