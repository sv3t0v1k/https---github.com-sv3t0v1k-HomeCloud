# Рабочий шаблон Mac: cp .env.example .env; chmod 600 .env.
# Секреты обязательны; генерировать каждый отдельно: openssl rand -hex 32.
# .env не коммитить. Для существующей БД сохранить её DB_PASSWORD.
COMPOSE_PROJECT_NAME=homecloud-preview
HTTP_PORT=8080
DB_NAME=homecloud
DB_USER=homecloud
DB_PASSWORD=
JWT_SECRET=
JWT_REFRESH_SECRET=
# Dev startup validator требует пароль даже при выключенном Redis.
REDIS_PASSWORD=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
UPLOAD_SESSION_TTL_HOURS=24
MAX_FILE_SIZE=1099511627776
MAX_TOTAL_SIZE=2199023255552
MAX_UPLOAD_CHUNKS=100000
MAX_CHUNK_SIZE=52428800
# Пустой токен отключает metrics; публичные proxy никогда их не открывают.
METRICS_TOKEN=
# Явные image имена необходимы D1 backup/restore. Обновлять через build.
RELEASE_BACKEND_IMAGE=homecloud-backend:dev
RELEASE_FRONTEND_IMAGE=homecloud-frontend:dev

# Linux/prod override: заполнить только для подготовки deployment, НЕ для Mac.
# Новая машина: отдельное project name homecloud; не использовать Mac volumes.
# БД на SSD, permanent files на HDD. Пути существуют на daemon host.
SSD_DB_DIR=/srv/homecloud-ssd/postgres
HDD_STORAGE_DIR=/srv/homecloud-hdd/storage
PUBLIC_HOST=
PUBLIC_BIND_IP=0.0.0.0
TLS_CERT_DIR=/etc/homecloud/tls
ACME_WEBROOT_DIR=/var/lib/homecloud/acme
BACKEND_PROXY_SUBNET=172.30.0.0/24
FRONTEND_PROXY_IP=172.30.0.10
INGRESS_SUBNET=172.29.0.0/24
INGRESS_PROXY_IP=172.29.0.10
# SSD feature hard-coded OFF в Compose; mount mapping variables отсутствуют.
# COMPOSE_FILE для recovery задавать абсолютными paths в EXTERNAL recovery env.
